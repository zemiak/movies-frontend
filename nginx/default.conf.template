# The single-page app, plus /api/ → the movies backend (same origin: no CORS, no mixed content,
# and the stream URLs handed to Infuse point at this host).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${MOVIES_API}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        # Video: stream straight through (Range requests, long transfers).
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 1m;
    }

    # Hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /health { return 200 "ok\n"; }

    # Runtime settings for the app. STREAM_BASE: the backend URL that "Open in Infuse" links point at
    # (Infuse can't sign in to an auth proxy in front of this app); empty: this host's /api.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-cache";
        return 200 '{"streamBase":"${STREAM_BASE}"}';
    }

    # Client-side routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
